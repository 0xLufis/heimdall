layout {
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane split_direction="vertical" {
        pane split_direction="horizontal" {
            pane name="Backend API" command="bash" {
                args "-c" "export DOTNET_ROOT=\"$HOME/.dotnet\" && export PATH=\"$HOME/.dotnet:$PATH\" && dotnet run --project backend/App.Backend.Api"
            }
            pane name="Local Agent" command="bash" {
                args "-c" "export DOTNET_ROOT=\"$HOME/.dotnet\" && export PATH=\"$HOME/.dotnet:$PATH\" && dotnet run --project agent/App.Agent.Daemon"
            }
        }
        pane split_direction="horizontal" {
            pane name="Nuxt Frontend" command="bash" {
                args "-c" "export PATH=\"$HOME/.bun/bin:$PATH\" && bun --cwd=frontend/nuxt-app run dev"
            }
            pane name="PC Simulator" command="bash" {
                args "-c" "source venv/bin/activate && python simulate_pcs.py"
            }
            pane name="ngrok" command="bash" {
                args "-c" "if command -v ngrok >/dev/null 2>&1; then ngrok http 3000; else echo 'ngrok not found, skipping...'; sleep 10; fi"
            }
        }
    }
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
