# Heimdall Industrial Edge Agent Environment Configuration
# Location: /etc/heimdall/agent.env

# Central telemetry and command server (MQTT broker host & port)
MQTT_BROKER_HOST=10.0.0.10
MQTT_BROKER_PORT=1883
MQTT_USE_TLS=false

# Pre-shared edge authentication key matching the backend
HEIMDALL_AGENT_KEY=your_edge_agent_auth_key_here

# Local agent HTTP management & health check endpoint
AGENT_URLS=http://127.0.0.1:5998

# Device & Asset Identity overrides (optional: agent discovers local hostname/MAC by default)
# HEIMDALL_AGENT_HOSTNAME=IPC-LINE01-ROBOTICS
# HEIMDALL_ORGANIZATION_ID=Plant-North-Hall-B

# Telemetry spooling & local persistence directory
HEIMDALL_SPOOL_DIR=/var/lib/heimdall-agent/spool

# Security & Path sanitization
# Set to true to preserve user home directory paths without scrubbing
HEIMDALL_PRESERVE_USER_HOME_PATHS=false
