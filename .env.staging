# ==============================================================================
# HEIMDALL INDUSTRIAL OT PLATFORM - STAGING CONFIGURATION
# ==============================================================================
# Mirrors production-grade security and isolation with:
# - NO development features (dev login bypass, Swagger UI, simulated AD OUs disabled)
# - ONLY debug features enabled (verbose diagnostic logs, telemetry debug inspection)
# - Full enterprise seed dataset loaded into heimdall_staging_db
# ==============================================================================

# 1. Environment & Feature Flags (NO dev features, ONLY debug)
ASPNETCORE_ENVIRONMENT=Staging
NODE_ENV=production
DOTNET_ENVIRONMENT=Staging

# Strictly disable development bypass and seeding features
HEIMDALL_ENABLE_DEV=false
NUXT_PUBLIC_ENABLE_DEV_FEATURES=false
ENABLE_DEV_HTTP_SEED=false

# Enable debug diagnostic features only
HEIMDALL_ENABLE_DEBUG=true
HEIMDALL_DEBUG=true
NUXT_PUBLIC_ENABLE_DEBUG_FEATURES=true

# 2. Cryptographic & Security Keys (Strict non-default entropy)
HEIMDALL_ENCRYPTION_KEY=Heimdall_AES256_GCM_Staging_Key_2026_Secure32B!
BETTER_AUTH_SECRET=heimdall_staging_auth_secret_minimum_32_characters_long!
BETTER_AUTH_URL=http://localhost:3000
JWT_SIGNING_KEY=heimdall_staging_jwt_secret_key_minimum_64_bytes_for_hmac_sha256_security_token!
HEIMDALL_AGENT_KEY=heimdall-staging-agent-auth-key-secure

# 3. Database & Caching Infrastructure (Isolated Staging Database)
POSTGRES_DB=heimdall_staging_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
DATABASE_URL=postgres://dotnet_backend:your_backend_pw@localhost:5432/heimdall_staging_db
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=heimdall_staging_db;Username=ef_admin;Password=migrate

REDIS_PASSWORD=heimdall_redis_dev_secret
REDIS_URL=redis://:heimdall_redis_dev_secret@localhost:6379
REDIS_CONNECTION_STRING=localhost:6379,password=heimdall_redis_dev_secret,abortConnect=false

# 4. Networking, Ports & Origins
HOST=0.0.0.0
PORT=3000
WEB_PORT=3000
BACKEND_HTTP_PORT=5099
BACKEND_API_URL=http://localhost:5099
SIGNALR_HUB_URL=http://localhost:5099/hubs/maintenance
NUXT_PUBLIC_API_BASE=http://localhost:3000/api
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5099,http://127.0.0.1:5099

# 5. Industrial Telemetry Transport
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_EMBEDDED_BROKER=true
MQTT_EMBEDDED_PORT=1883
MQTT_USE_TLS=false

# 6. Windows Edge Agent Container Profile
WIN_VERSION=10l
WIN_RAM=3G
WIN_CPU=2
WIN_DISK=20G
