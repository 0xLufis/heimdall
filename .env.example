# ==============================================================================
# HEIMDALL INDUSTRIAL OT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this template to .env, .env.dev, .env.staging, or .env.prod as needed.
# For production and staging environments, ensure all secrets are replaced with
# cryptographically secure random values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Feature Flags
# ------------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT: Development | Staging | Production | Test
ASPNETCORE_ENVIRONMENT=Development
# NODE_ENV: development | production | test
NODE_ENV=development
# DOTNET_ENVIRONMENT: Development | Staging | Production
DOTNET_ENVIRONMENT=Development

# HEIMDALL_ENABLE_DEV: Enables dev mock endpoints, Swagger UI, permissive CORS,
# dev login bypass, and simulated Active Directory OU preview imports.
# In Staging and Production, MUST BE SET TO false for security compliance.
HEIMDALL_ENABLE_DEV=true

# HEIMDALL_ENABLE_DEBUG: Governs verbose diagnostic dumps, raw telemetry debug exports,
# and internal state inspection. Can be enabled in staging/debug environments without
# exposing development bypass features.
HEIMDALL_ENABLE_DEBUG=true
HEIMDALL_DEBUG=true

# Frontend public feature flags (exposed to client bundle)
NUXT_PUBLIC_ENABLE_DEV_FEATURES=true
NUXT_PUBLIC_ENABLE_DEBUG_FEATURES=true

# Development HTTP Seed Endpoint toggle (/api/dev/seed-admin)
# Automatically blocked in non-development modes
ENABLE_DEV_HTTP_SEED=true

# ------------------------------------------------------------------------------
# 2. Cryptographic & Security Keys
# ------------------------------------------------------------------------------
# HEIMDALL_ENCRYPTION_KEY: AES-256-GCM database field encryption key.
# In Staging and Production, MUST be at least 32 characters long.
HEIMDALL_ENCRYPTION_KEY=Heimdall_AES256_GCM_DevSecretKey_32B

# BETTER_AUTH_SECRET: Secret key for Better-Auth session tokens and cookies.
# Must be at least 32 characters long; default dev keys are rejected in production.
BETTER_AUTH_SECRET=heimdall-dev-secret-key-32-chars-min-security
BETTER_AUTH_URL=http://localhost:3000

# JWT_SIGNING_KEY: HMAC-SHA256 signature key for backend API access tokens.
# Must be at least 64 bytes (characters) long in production.
JWT_SIGNING_KEY=heimdall_dev_jwt_secret_must_be_long_and_secure_64_bytes_entropy_token

# HEIMDALL_AGENT_KEY: Pre-shared authentication key for industrial edge agents.
HEIMDALL_AGENT_KEY=heimdall-dev-agent-key

# ------------------------------------------------------------------------------
# 3. Database & Caching Infrastructure
# ------------------------------------------------------------------------------
# PostgreSQL Database Name
POSTGRES_DB=heimdall_dev_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Database URLs for Backend (.NET EF Core / Npgsql) and Frontend (Drizzle ORM)
DATABASE_URL=postgres://dotnet_backend:your_backend_pw@localhost:5432/heimdall_dev_db
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=heimdall_dev_db;Username=ef_admin;Password=migrate

# Redis Caching & Spool Buffer
REDIS_PASSWORD=heimdall_redis_dev_secret
REDIS_URL=redis://:heimdall_redis_dev_secret@localhost:6379
REDIS_CONNECTION_STRING=localhost:6379,password=heimdall_redis_dev_secret,abortConnect=false

# ------------------------------------------------------------------------------
# 4. Networking, Ports & Origins
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
WEB_PORT=3000
BACKEND_HTTP_PORT=5099
BACKEND_API_URL=http://localhost:5099
SIGNALR_HUB_URL=http://localhost:5099/hubs/maintenance
NUXT_PUBLIC_API_BASE=http://localhost:3000/api

# Permitted CORS origins for API requests (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5099,http://127.0.0.1:5099

# ------------------------------------------------------------------------------
# 5. Industrial Telemetry & MQTT Broker
# ------------------------------------------------------------------------------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_EMBEDDED_BROKER=true
MQTT_EMBEDDED_PORT=1883
MQTT_USE_TLS=false

# ------------------------------------------------------------------------------
# 6. Windows Edge Agent Container (Optional KVM Profile)
# ------------------------------------------------------------------------------
WIN_VERSION=10l
WIN_RAM=3G
WIN_CPU=2
WIN_DISK=20G

# ------------------------------------------------------------------------------
# 7. Microsoft Entra ID (Azure SSO) Integration (Optional)
# ------------------------------------------------------------------------------
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=azure-client-secret-placeholder
AZURE_AD_TENANT_ID=72f988bf-86f1-41af-91ab-2d7cd011db47
AZURE_AD_SCOPES=openid,profile,email,User.Read
