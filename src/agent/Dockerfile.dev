FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /workspace

# Create non-root user and setup directories
RUN groupadd -g 10002 agentuser && \
    useradd -u 10002 -g agentuser -m -s /bin/bash agentuser && \
    chown -R agentuser:agentuser /workspace /home/agentuser

# Copy Directory.Build.props and project files for layer caching
COPY Directory.Build.props ./
COPY src/shared/App.Contracts/App.Contracts.csproj ./src/shared/App.Contracts/
COPY src/agent/App.Agent.Daemon/App.Agent.Daemon.csproj ./src/agent/App.Agent.Daemon/

# Restore dependencies
RUN dotnet restore src/agent/App.Agent.Daemon/App.Agent.Daemon.csproj

# Copy source code
COPY src/shared/ ./src/shared/
COPY src/agent/ ./src/agent/

RUN chown -R agentuser:agentuser /workspace

USER agentuser

WORKDIR /workspace/src/agent/App.Agent.Daemon

ENV DOTNET_ENVIRONMENT=Development
ENV DOTNET_USE_POLLING_FILE_WATCHER=1
ENV Backend__Url=http://backend:5001

ENTRYPOINT ["dotnet", "watch", "run", "--non-interactive"]
