# Heimdall Manufacturing Telemetry & Edge Control Platform
# Environment Configuration Template

# Better-Auth Platform Security
BETTER_AUTH_SECRET=heimdall_super_secret_plant_key_2026
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL / Drizzle ORM Connection
DATABASE_URL=postgres://heimdall:heimdall@localhost:5432/heimdall_db

# Microsoft Entra ID (Azure SSO) Integration
# Supported variable prefixes: AZURE_AD_*, MICROSOFT_ENTRA_ID_*, AZURE_*
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=azure-client-secret-placeholder
AZURE_AD_TENANT_ID=72f988bf-86f1-41af-91ab-2d7cd011db47
AZURE_AD_SCOPES=openid,profile,email,User.Read

# Backend .NET 10 API URL (For Claims Transformer & Active Directory Integration)
BACKEND_API_URL=http://localhost:5000
NUXT_PUBLIC_API_BASE=http://localhost:3000/api

# Feature Flags & Dev Overrides
NUXT_PUBLIC_ENABLE_DEV_FEATURES=true
NUXT_PUBLIC_ENABLE_DEBUG_FEATURES=true

# Platform Module Toggles (true/false, 1/0, yes/no, on/off, enabled/disabled)
# Can be toggled individually, via presets (HEIMDALL_MODULE_PRESET), or lists (HEIMDALL_MODULES / HEIMDALL_DISABLED_MODULES)
# Presets: 'all' | 'telemetry-ticketing' | 'ticketing-only' | 'telemetry-only' | 'core-only'
HEIMDALL_MODULE_PRESET=all
HEIMDALL_MODULE_TICKETING=true
HEIMDALL_MODULE_INVENTORY=true
HEIMDALL_MODULE_TELEMETRY=true

