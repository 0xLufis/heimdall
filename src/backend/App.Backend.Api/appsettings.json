{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "QueueFullMode": "DropWrite",
      "MaxQueueLength": 10000
    },
    "File": {
      "Enabled": false,
      "Path": "logs",
      "FileName": "backend.log",
      "MaxFileSizeMB": 20,
      "MaxTotalSizeMB": 200,
      "MaxAgeDays": 7,
      "QueueCapacity": 20000,
      "FlushIntervalSeconds": 1,
      "ShutdownTimeoutSeconds": 2
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;backend;heimdall_backend;host.docker.internal"
}
